# ── 必填：生成方式 python -c "import secrets; print(secrets.token_hex(32))" ──
# 生产模式（DEBUG=false）下弱密钥将拒绝启动
SECRET_KEY=

# ── 数据库与附件（容器内路径，挂载到宿主机 ./data）──
DATABASE_URL=sqlite+aiosqlite:////app/data/telecom.db
UPLOAD_DIR=/app/data/uploads

# ── 应用 ──
DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── 对外端口 ──
APP_PORT=8080

# ── 时区（影响每日快照/超期扫描的本地时间）──
TZ=Asia/Shanghai
