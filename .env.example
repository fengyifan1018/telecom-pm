# ── 必填：生成方式 python -c "import secrets; print(secrets.token_hex(32))" ──
# 生产模式（DEBUG=false）下弱密钥将拒绝启动
SECRET_KEY=

# ── 数据库与附件（容器内路径，挂载到宿主机 ./data）──
DATABASE_URL=sqlite+aiosqlite:////app/data/telecom.db
UPLOAD_DIR=/app/data/uploads

# ── 应用 ──
DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── 国内服务器拉不动 Docker Hub 时取消注释（镜像加速）──
# BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# BASE_NODE_IMAGE=docker.m.daocloud.io/library/node:20-alpine
# BASE_NGINX_IMAGE=docker.m.daocloud.io/library/nginx:alpine

# ── 企业微信智能机器人推送（可选：填入后启动 wecom 长连接服务）──
# 创建：企微群/管理后台 → 智能机器人 → API 模式 → 长连接 → 获取 BotID/Secret
# 启用推送：docker compose --profile wecom up -d
WECHAT_BOT_ID=
WECHAT_BOT_SECRET=
APP_BASE_URL=

# ── 对外端口 ──
APP_PORT=8080

# ── 时区（影响每日快照/超期扫描的本地时间）──
TZ=Asia/Shanghai
